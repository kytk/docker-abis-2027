# alias for xdg-open
alias open='xdg-open &> /dev/null'

# shopt
shopt -s direxpand
shopt -s autocd

# Disable screensaver
xset s off

# XDG Runtime Directory
export XDG_RUNTIME_DIR="/tmp/runtime-brain"
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true

# Qt Session Management - Disable to avoid VNC authentication errors
unset SESSION_MANAGER
export QT_X11_NO_MITSHM=1
export QT_GRAPHICSSYSTEM=native
export QT_X11_NO_XIM=1

# Mango
export PATH=$PATH:/usr/local/Mango

# MRIcroGL
export PATH=/usr/local/MRIcroGL:$PATH
export PATH=/usr/local/MRIcroGL/Resources:$PATH

#ANTs
export ANTSPATH=/usr/local/ANTs/bin
export PATH=$PATH:$ANTSPATH

# MRtrix3
export PATH=$PATH:/usr/local/mrtrix3/bin

# dcm2niix
export PATH=/usr/local/dcm2niix:$PATH

#SPM25 standalone
alias spm25='/usr/local/spm25_standalone/run_spm25.sh /usr/local/MATLAB/MCR/R2024b 2>/dev/null'

#conn25b standalone
alias conn='/usr/local/conn25b_standalone/run_conn.sh /usr/local/MATLAB/MCR/R2024b 2>/dev/null'

#FreeSurfer 8.2.0
export SUBJECTS_DIR=~/freesurfer/8.2.0/subjects
export FREESURFER_HOME=/usr/local/freesurfer/8.2.0
export FS_LICENSE=~/share/license.txt
source $FREESURFER_HOME/SetUpFreeSurfer.sh

# FSL Setup
FSLDIR=/usr/local/fsl
PATH=${FSLDIR}/share/fsl/bin:${PATH}
export FSLDIR PATH
. ${FSLDIR}/etc/fslconf/fsl.sh

# fs-scripts 
PATH=$PATH:/home/brain/git/fs-scripts

# kn-scripts 
PATH=$PATH:/home/brain/git/kn-scripts

# Python venv
# Ubuntu 24.04 enforces PEP 668, so pip packages are installed into this venv
# at image build time. Prepending its bin directory makes python3, pip and
# jupyter resolve to the venv without an explicit "source .venv/bin/activate".
export PATH=/home/brain/.venv/bin:$PATH

