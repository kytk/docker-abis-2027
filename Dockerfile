# syntax=docker/dockerfile:1

# Dockerfile for kytk/abis-2027 with Multi-Stage Build
# Author: K. Nemoto
# Date: 22 Sep 2026
# Description: This Dockerfile uses a multi-stage build to create a smaller,
#              optimized container image for neuroimaging analysis.

# 1.0.20: change the base from 22.04 to 24.04
#         - AlizaMS: switch from the OBS .deb (22.04 only) to the upstream
#           "binary only" tarball + Qt5 libraries from apt (no Flatpak needed)
#         - Rename apt packages that no longer exist on noble
#           (libgtk2.0-0 -> libgtk2.0-0t64, libopenblas-base -> libopenblas0,
#            libncurses5 -> libncurses6)
#         - Python: install pip packages into a venv because noble enforces
#           PEP 668 (externally-managed-environment) for system-wide pip
#         - FreeSurfer 8.2.0: apply the official fs820_updates.sh patch (the
#           Ubuntu 24 build ships a samseg "gemsbindings" module for the wrong
#           Python and run_samseg/segment_subregions fail without it), install
#           the deb's runtime library dependencies in the final stage (8.2.0
#           links against the system ITK/VTK/Qt5 instead of bundling them, so
#           copying /usr/local/freesurfer alone leaves 300+ binaries without
#           their shared libraries), and drop MCRv97 (subfield segmentation is
#           done with the Python "segment_subregions" instead of the MATLAB
#           runtime based segmentHA_*/segmentBS/segmentThalamicNuclei scripts)
#         - MATLAB Runtime R2024b: replaced the monolithic installer (9.7 GB
#           installed) with a minimal installer generated by
#           compiler.runtime.customInstaller from SPM25's requiredMCRProducts.txt
#           (CONN25b needs the identical component set); 6.3 GB installed,
#           ~3.4 GB after the NVIDIA libraries are removed
#         - Image size: all pruning now happens in the builder stage BEFORE the
#           COPY --from steps. Deleting files in a later layer never shrinks a
#           Docker image, so the old Part 4/5 cleanup had no effect. Pruned:
#           FSL conda package cache (pkgs/, 20 GB), FSL headers and compiler
#           sysroot, NVIDIA/CUDA libraries of the MATLAB runtime (no GPU here)
#         - Ownership: files that must belong to "brain" are chown'ed in the
#           builder stage (COPY --from preserves ownership) or copied with
#           --chown. The old recursive chown in the final stage made overlayfs
#           copy every touched file into a new 3.7 GB layer
#         - User: noble's base image ships a default "ubuntu" user with uid 1000;
#           it is removed so that "brain" keeps uid/gid 1000 as on 22.04
#         - HEALTHCHECK: "healthy" once the window manager is up and noVNC
#           answers, so launcher scripts can wait with "docker inspect"
#         - Git: /etc/gitconfig sets safe.directory='*' and core.fileMode=false,
#           so that repositories on a bind-mounted share folder work even when
#           Docker reports them as root-owned with 0777 modes
#         - Desktop menu: Applications button uses the brain icon, and the
#           "Neuroimaging" submenu is installed (custom xfce-applications.menu +
#           Neuroimaging.directory + .desktop entries + icons in /usr/share/pixmaps)
#         - FSL: the build asserts that the interpreter the share/fsl/bin
#           wrappers call actually exists (a tree upgraded in place can name a
#           Python version it no longer ships, which only fails at run time)
#         - Build cache: every RUN bind-mounts only the files it needs (a mount
#           of the whole packages/ directory made any change in packages/
#           invalidate every RUN), and the builder is split into independent
#           stages per tool so that replacing one archive rebuilds one stage.
#           BuildKit also runs the independent stages in parallel. This changes
#           nothing in the final image: its layers are the same COPY/RUN steps.

#------------------------------------------------------------------------------
# Stage 1: The "Builder" Stages
# - base-builder installs the build-time tools shared by all builders.
# - tools-builder / fs-builder / mcr-builder / fsl-builder each extract and
#   install one group of neuroimaging software, independently of the others:
#   a change to one package archive only rebuilds its own stage, and BuildKit
#   builds the stages in parallel.
# - Each stage prunes everything that is not needed at runtime (this MUST
#   happen here: files deleted in the final stage still occupy space in
#   earlier layers).
# - These stages are large, but they are discarded after the build.
#------------------------------------------------------------------------------
FROM ubuntu:24.04 AS base-builder

# Set non-interactive frontend for package installation
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Tokyo

# Install build-time dependencies and essential tools
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential ca-certificates dkms \
      curl wget git gnupg \
      unzip zip p7zip-full pigz file 

#------------------------------------------------------------------------------
# tools-builder: MRIcroGL, dcm2niix, MRtrix3, ANTs
#------------------------------------------------------------------------------
FROM base-builder AS tools-builder

RUN --mount=type=bind,source=build/packages/MRIcroGL_linux.zip,target=/tmp/packages/MRIcroGL_linux.zip \
    --mount=type=bind,source=build/packages/dcm2niix_lnx.zip,target=/tmp/packages/dcm2niix_lnx.zip \
    --mount=type=bind,source=build/packages/mrtrix3_noble.zip,target=/tmp/packages/mrtrix3_noble.zip \
    --mount=type=bind,source=build/packages/ANTs-noble.zip,target=/tmp/packages/ANTs-noble.zip \
    set -ex && \
    # MRIcroGL
    unzip /tmp/packages/MRIcroGL_linux.zip -d /usr/local/ && \
    # dcm2niix
    mkdir -p /usr/local/dcm2niix && \
    unzip /tmp/packages/dcm2niix_lnx.zip -d /usr/local/dcm2niix && \
    # MRtrix3
    unzip /tmp/packages/mrtrix3_noble.zip -d /usr/local && \
    # ANTs
    unzip /tmp/packages/ANTs-noble.zip -d /usr/local

#------------------------------------------------------------------------------
# fs-builder: FreeSurfer 8.2.0 + official patch + bert
#------------------------------------------------------------------------------
FROM base-builder AS fs-builder

RUN --mount=type=bind,source=build/packages/freesurfer_ubuntu24-8.2.0_amd64.deb,target=/tmp/packages/freesurfer_ubuntu24-8.2.0_amd64.deb \
    --mount=type=bind,source=build/packages/fs820_updates.sh,target=/tmp/packages/fs820_updates.sh \
    --mount=type=bind,source=build/packages/patch_data_20260625.tgz,target=/tmp/packages/patch_data_20260625.tgz \
    --mount=type=bind,source=build/packages/bert.zip,target=/tmp/packages/bert.zip \
    set -ex && \
    # FreeSurfer (install deps first)
    apt install -y /tmp/packages/freesurfer_ubuntu24-8.2.0_amd64.deb && \
    # Apply the official 8.2.0 update (fs820_updates.sh). The Ubuntu 24 build
    # ships samseg/gems/gemsbindings compiled for CPython 3.12 while fspython
    # is 3.8, which breaks run_samseg and segment_subregions; the patch adds
    # the cpython-38 module and also updates recon-all, mri_glmfit, rca-surfreg
    # and others. The patch archive is bundled in packages/ and passed as $1 so
    # every rebuild applies the same patch level (the script still downloads
    # the tiny "default" index file from the FreeSurfer server).
    # The script asks "[Yy/Nn]" per file with "read -n 1"; a plain "yes |"
    # feeds "y\n" and every second prompt would receive the newline and be
    # skipped, hence the newlines are stripped.
    mkdir -p /tmp/fs_patch && cd /tmp/fs_patch && \
    cp /tmp/packages/fs820_updates.sh /tmp/packages/patch_data_20260625.tgz . && \
    yes | tr -d '\n' | FREESURFER_HOME=/usr/local/freesurfer/8.2.0 \
      bash fs820_updates.sh patch_data_20260625.tgz && \
    cd / && rm -rf /tmp/fs_patch && \
    # Fail the build if the patch did not deliver the working gems module
    test -f /usr/local/freesurfer/8.2.0/python/lib/python3.8/site-packages/samseg/gems/gemsbindings.cpython-38-x86_64-linux-gnu.so && \
    # Remove the unusable CPython 3.12 module left behind by the deb
    rm -f /usr/local/freesurfer/8.2.0/python/lib/python3.8/site-packages/samseg/gems/gemsbindings.cpython-312-*.so && \
    FREESURFER_HOME=/usr/local/freesurfer/8.2.0 /usr/local/freesurfer/8.2.0/bin/fspython -c "import samseg" && \
    # MCRv97 (MATLAB runtime for segmentHA_*/segmentBS/segmentThalamicNuclei)
    # is intentionally NOT installed any more (-7.4 GB); the tutorial uses the
    # Python implementation "segment_subregions" for the same structures.
    # Prepare FreeSurfer subjects directory for the user
    mkdir -p /home/brain/freesurfer/8.2.0 && \
    mkdir -p /home/brain/matlab && \
    ln -s /usr/local/freesurfer/8.2.0/subjects /home/brain/freesurfer/8.2.0/ && \
    unzip /tmp/packages/bert.zip -d /usr/local/freesurfer/8.2.0/subjects/ && \
    # Hand the subjects directory and the home skeleton to brain (uid/gid 1000)
    # here: COPY --from keeps this ownership, so the final stage needs no
    # recursive chown over these trees.
    chown -R 1000:1000 /usr/local/freesurfer/8.2.0/subjects /home/brain

#------------------------------------------------------------------------------
# mcr-builder: MATLAB Runtime R2024b (custom), SPM25, CONN
#------------------------------------------------------------------------------
FROM base-builder AS mcr-builder

RUN --mount=type=bind,source=build/packages/abis_mcr_r2024b/abis_mcr_r2024b.install,target=/tmp/packages/abis_mcr_r2024b/abis_mcr_r2024b.install \
    --mount=type=bind,source=build/packages/spm25_standalone_noble_R2024b.zip,target=/tmp/packages/spm25_standalone_noble_R2024b.zip \
    --mount=type=bind,source=build/packages/conn25b_glnxa64.zip,target=/tmp/packages/conn25b_glnxa64.zip \
    set -ex && \
    # MATLAB Runtime R2024b (custom minimal build)
    # abis_mcr_r2024b.install was generated on MATLAB R2024b Update 9 with
    #   compiler.runtime.customInstaller("abis_mcr_r2024b", "requiredMCRProducts.txt", RuntimeDelivery="installer")
    # from SPM25's requiredMCRProducts.txt (35000 35002 35003 35010 35108 35180
    # 35380); CONN25b requires the identical set. It installs only those runtime
    # components (6.3 GB instead of 9.7 GB for the monolithic runtime), and the
    # runtime verifies the required components when an application starts.
    # The installer is a self-extracting ELF; it needs "unzip" (installed above)
    # and a writable working directory. Same silent options as the full installer.
    cd /tmp && \
    /tmp/packages/abis_mcr_r2024b/abis_mcr_r2024b.install \
        -mode silent -agreeToLicense yes -destinationFolder /usr/local/MATLAB/MCR/ && \
    # MATLAB MCR cleanup (moved here from the final stage so that it actually
    # reduces the image). Removes the licence/patent text, documentation,
    # examples, demos and tutorials. Only deletions that have been exercised in
    # earlier images are kept: the old chain also tried to delete *win32*,
    # *.h, unused toolboxes etc., but "find -name '*win32*' -delete" fails on a
    # matching directory that still contains other files, and the trailing
    # "|| true" of that chain silently swallowed the failure - so none of the
    # later steps (including the NVIDIA prune) ever ran, and the runtime stayed
    # at its full size. Nothing here may end in "|| true" any more.
    cd /usr/local/MATLAB/MCR/R2024b && \
    rm -rf help/ patents.txt trademarks.txt matlabruntime_license_agreement.pdf && \
    find . -type d -name "*doc*" -exec rm -rf {} + && \
    find . -type d -name "*example*" -exec rm -rf {} + && \
    find . -type d -name "*demo*" -exec rm -rf {} + && \
    find . -type d -name "*tutorial*" -exec rm -rf {} + && \
    find . -type f \( -name "*.pdf" -o -name "*.html" -o -name "*.htm" \) -delete && \
    # NVIDIA/CUDA libraries (cuBLAS, cuDNN, cuFFT, cuSPARSE, cuSOLVER, NCCL,
    # NVRTC, NPP, ...) are only used by GPU functions; the container has no GPU.
    # They belong to the runtime "Core" component, so the custom installer still
    # ships them: ~2.9 GB. libcurl* matches "libcu*" and must stay; libmw* are
    # kept too. sys/cuda holds CUDA support files and goes as well.
    find bin/glnxa64 -maxdepth 1 ! -type d \( -name 'libcu*' -o -name 'libnv*' -o -name 'libnccl*' -o -name 'libnpp*' \) \
      ! -name 'libcurl*' -delete && \
    rm -rf sys/cuda && \
    echo "MATLAB Runtime after cleanup: $(du -sh /usr/local/MATLAB/MCR/R2024b | cut -f1)" && \
    # SPM25
    unzip /tmp/packages/spm25_standalone_noble_R2024b.zip -d /tmp/ && \
    mv /tmp/spm25_standalone /usr/local && \
    # CONNv25b
    # conn25b_glnxa64.zip has no top-level directory (conn, run_conn.sh, ... sit
    # at the archive root), so extract into an explicit target directory.
    # Extracting into /usr/local directly scatters the files and the chmod below fails.
    mkdir -p /usr/local/conn25b_standalone && \
    unzip /tmp/packages/conn25b_glnxa64.zip -d /usr/local/conn25b_standalone && \
    chmod 755 /usr/local/conn25b_standalone/run_conn.sh && \
    chmod 755 /usr/local/conn25b_standalone/conn

#------------------------------------------------------------------------------
# fsl-builder: FSL + git scripts
#------------------------------------------------------------------------------
FROM base-builder AS fsl-builder

RUN --mount=type=bind,source=build/packages/fsl-6.0.7.23-noble.tar.gz,target=/tmp/packages/fsl-6.0.7.23-noble.tar.gz \
    set -ex && \
    # FSL
    tar -xf /tmp/packages/fsl-6.0.7.23-noble.tar.gz -C /usr/local/ && \
    # The FSL tarball carries the conda package cache (pkgs/, ~20 GB of
    # duplicates of what is already installed under lib/ etc.) plus headers and
    # the compiler sysroot that are only needed for building packages.
    rm -rf /usr/local/fsl/pkgs /usr/local/fsl/include /usr/local/fsl/src \
           /usr/local/fsl/x86_64-conda-linux-gnu && \
    # The wrappers under share/fsl/bin call their Python interpreter by
    # absolute path. A tarball taken from an FSL tree that was upgraded in
    # place can name a version that is no longer shipped (6.0.7.23 did: the
    # wrappers called bin/python3.12 while the tree had bin/python3.14), and
    # the tools then fail only at run time. Assert it here instead.
    fsl_python="$(sed -n 2p /usr/local/fsl/share/fsl/bin/fsleyes | awk '{print $1}')" && \
    echo "FSL wrappers use interpreter: ${fsl_python}" && \
    test -x "${fsl_python}" && \
    # Drop dangling symlinks and list them in the build log. The tarball itself
    # ships one broken link (a gdb auto-load helper); anything that pointed into
    # the removed trees would show up here as well. The compiler wrappers in
    # bin/ (gcc, ld, ...) point to binaries that stay in bin/, so they survive.
    find /usr/local/fsl -xtype l -print -delete && \
    # Git Scripts
    mkdir -p /home/brain/git && \
    cd /home/brain/git && \
    git clone https://gitlab.com/kytk/fs-scripts.git && \
    git clone https://gitlab.com/kytk/kn-scripts.git && \
    chown -R 1000:1000 /home/brain/git

#------------------------------------------------------------------------------
# Stage 2: The "Final" Stage
# - Starts from a clean Ubuntu base image.
# - Installs only runtime dependencies.
# - Copies the pre-built software from the "builder" stage.
# - Configures the user and environment.
#------------------------------------------------------------------------------
FROM ubuntu:24.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Tokyo \
    DISPLAY=:1

# Part 0: Create the "brain" user first
# noble's base image already contains a user "ubuntu" with uid/gid 1000. It is
# removed so that brain gets uid/gid 1000 as in the 22.04 image (matters for
# bind-mounted folders). Creating the user before anything is copied into
# /home/brain lets the later COPY --chown steps refer to it.
RUN set -ex && \
    if id ubuntu >/dev/null 2>&1; then userdel -r ubuntu; fi && \
    useradd -u 1000 -m -s /bin/bash brain && \
    echo "brain:lin4neuro" | chpasswd && \
    usermod -aG sudo brain

# Part 1: Install runtime dependencies
RUN --mount=type=bind,source=build/packages/freesurfer_ubuntu24-8.2.0_amd64.deb,target=/tmp/packages/freesurfer_ubuntu24-8.2.0_amd64.deb \
    --mount=type=bind,source=build/packages/alizams_binary_only-1.10.3.tar.gz,target=/tmp/packages/alizams_binary_only-1.10.3.tar.gz \
    set -ex && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      # XFCE Desktop & VNC
      xfce4-session xfce4-panel xfwm4 xfce4-terminal xfce4-settings \
      xfdesktop4 xfce4-screenshooter xfce4-appfinder \
      shimmer-themes \
      thunar thunar-archive-plugin file-roller xdg-utils \
      gnome-icon-theme tango-icon-theme elementary-xfce-icon-theme \
      # noble: libgtk2.0-0 was renamed to libgtk2.0-0t64 (64-bit time_t transition)
      libgtk2.0-0t64 xinit \
      tightvncserver novnc websockify net-tools supervisor \
      x11vnc xvfb dbus-x11 sudo \
      dbus \
      # Python
      python3-pip python3-venv python3-tk python3-gpg \
      # Core Utilities
      wget tzdata iputils-ping less nano rsync locate git apt-utils apt-file \
      apturl at-spi2-core bc dc ca-certificates default-jre evince gedit \
      gnome-system-monitor gnome-system-tools baobab imagemagick file \
      vim rename ntp tree unzip zip p7zip-full pigz csh tcsh gnupg meld \
      # Fonts & Themes
      software-properties-common fonts-noto fonts-noto-cjk fonts-ipafont \
      appmenu-gtk-module-common appmenu-gtk2-module libappmenu-gtk2-parser0 \
      # Apps & Libs
      # noble: libopenblas-base was renamed to libopenblas0
      gawk sed libopenblas0 \
      # (libgtk2.0-0t64 is already listed above; the duplicate was removed)
      libjpeg62 language-pack-en gettext \
      # noble: libncurses5 is gone; only libncurses6 is available
      libncurses6 \
      # Qt5 runtime for the AlizaMS "binary only" build
      # (Qt5Core, Qt5Gui, Qt5Widgets, Qt5PrintSupport, Qt5Sql, Qt5Svg;
      #  libqt5svg5 is required for toolbar icons, libqt5sql5-sqlite for the SQL plugin)
      libqt5core5t64 libqt5gui5t64 libqt5widgets5t64 libqt5printsupport5t64 \
      libqt5sql5t64 libqt5sql5-sqlite libqt5svg5 && \
    apt-get install -y octave gnumeric && \
    # FreeSurfer runtime dependencies. The 8.2.0 Ubuntu 24 build links against
    # the system ITK 5.3, VTK 9.1, Qt5, MINC, NetCDF, HDF5, GDCM, GLEW, ... and
    # no longer bundles them, so the libraries listed in the deb's "Depends"
    # must exist in this stage as well. The list is taken from the deb itself
    # (so it follows the package), minus build-only entries: -dev packages,
    # xorg/xserver (X runs in Xvfb here), binutils, make and default-jdk
    # (default-jre above is enough). Version constraints and alternatives
    # ("libglu1-mesa | libglu1") are stripped; apt resolves them.
    fs_runtime_deps="$(dpkg-deb -f /tmp/packages/freesurfer_ubuntu24-8.2.0_amd64.deb Depends \
      | tr ',' '\n' \
      | sed -E 's/\(.*\)//; s/\|.*//; s/^[[:space:]]+//; s/[[:space:]]+$//' \
      | grep -vE '^$|-dev$|^binutils$|^make$|^xorg$|^xserver-xorg|^default-jdk$' \
      | sort -u | tr '\n' ' ')" && \
    echo "FreeSurfer runtime deps: ${fs_runtime_deps}" && \
    apt-get install -y --no-install-recommends ${fs_runtime_deps} && \
    cd /tmp/packages && \
    # AlizaMS installation
    # The OBS .deb is built for Ubuntu 22.04 only and does not work on noble.
    # Use the upstream "binary only" tarball instead; it depends solely on the
    # Qt5 libraries installed above. The binary is symlinked into /usr/local/bin
    # so that the .desktop entry (Exec=alizams) works without shell aliases.
    mkdir -p /usr/local/alizams && \
    tar -xzf /tmp/packages/alizams_binary_only-1.10.3.tar.gz \
        --strip-components=1 -C /usr/local/alizams && \
    ln -s /usr/local/alizams/alizams /usr/local/bin/alizams && \
    # Timezone setup
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && \
    echo $TZ > /etc/timezone && \
    dpkg-reconfigure -f noninteractive tzdata && \
    # Python package installation
    # noble enforces PEP 668: system-wide "pip install" is refused, so all pip
    # packages go into a venv at /home/brain/.venv. The venv is isolated (no
    # --system-site-packages) so that apt-provided modules such as python3-numpy
    # do not shadow the pip-installed versions. bash_aliases prepends the venv
    # bin directory to PATH so python3/pip/jupyter resolve to the venv.
    # The chown happens in this same RUN: doing it in a later layer would copy
    # the whole venv (~800 MB) into that layer again.
    python3 -m venv /home/brain/.venv && \
    /home/brain/.venv/bin/pip install --upgrade pip && \
    # "gdcm" on PyPI is an abandoned 2020 package that links against libgdcm 2.8
    # and fails to import on noble; "python-gdcm" is the official GDCM wheel
    # (provides "import gdcm", used by pydicom for compressed transfer syntaxes).
    /home/brain/.venv/bin/pip install --no-cache-dir \
       numpy pandas matplotlib seaborn jupyter notebook python-gdcm \
       pydicom heudiconv nipype nibabel && \
    chown -R brain:brain /home/brain/.venv && \
    # Firefox setup
    install -d -m 0755 /etc/apt/keyrings && \
    wget -q https://packages.mozilla.org/apt/repo-signing-key.gpg -O- | \
      gpg --dearmor -o /etc/apt/keyrings/packages.mozilla.org.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/packages.mozilla.org.gpg] https://packages.mozilla.org/apt mozilla main" | \
      tee /etc/apt/sources.list.d/mozilla.list > /dev/null && \
    echo 'Package: *\nPin: origin packages.mozilla.org\nPin-Priority: 1000' | \
      tee /etc/apt/preferences.d/mozilla && \
    apt-get update && \
    apt-get install -y --no-install-recommends firefox && \
    xdg-mime default firefox.desktop text/html && \
    # Final apt cleanup for this layer (must stay in this RUN to be effective)
    apt-get clean && \
    apt-get autoremove -y --purge && \
    rm -rf /var/lib/apt/lists/* && \
    # Remove locales other than English (moved here from the old Part 4)
    find /usr/share/locale -maxdepth 1 -mindepth 1 ! -name 'en*' -exec rm -r {} \;

# Part 2: Copy pre-built applications from the builder stages
# COPY --from preserves the ownership set in the builder stage; --chown is used
# only for the small trees that must belong to brain as a whole.
# Part 2a: Copy small neuroimaging tools (~2-3GB)
COPY --from=tools-builder /usr/local/MRIcroGL/ /usr/local/MRIcroGL/
COPY --from=tools-builder /usr/local/dcm2niix/ /usr/local/dcm2niix/
COPY --from=tools-builder /usr/local/mrtrix3/ /usr/local/mrtrix3/
COPY --from=tools-builder /usr/local/ANTs/ /usr/local/ANTs/

# Part 2b: Copy FreeSurfer (~19GB without MCRv97)
COPY --from=fs-builder /usr/local/freesurfer/ /usr/local/freesurfer/
COPY --from=fs-builder --chown=brain:brain /home/brain/freesurfer/ /home/brain/freesurfer/

# Part 2c: Copy MATLAB MCR R2024b (~3.5GB: custom runtime minus NVIDIA libraries)
COPY --from=mcr-builder /usr/local/MATLAB/ /usr/local/MATLAB/

# Part 2d: Copy SPM25 and CONN (~0.5GB)
COPY --from=mcr-builder --chown=brain:brain /usr/local/spm25_standalone/ /usr/local/spm25_standalone/
COPY --from=mcr-builder --chown=brain:brain /usr/local/conn25b_standalone/ /usr/local/conn25b_standalone/

# Part 2e: Copy FSL (~11GB after pruning)
COPY --from=fsl-builder /usr/local/fsl/ /usr/local/fsl/

# Part 2f: Copy git repositories and matlab startup
COPY --from=fsl-builder --chown=brain:brain /home/brain/git/ /home/brain/git/
COPY --from=fs-builder --chown=brain:brain /home/brain/matlab/ /home/brain/matlab/

# Part 3: User setup and configuration
COPY build/desktop/deep_ocean.png /usr/share/backgrounds/
COPY build/home/bash_aliases /etc/skel/.bash_aliases
COPY build/home/bash_aliases /root/.bash_aliases
COPY --chown=brain:brain build/home/bash_aliases /home/brain/.bash_aliases
COPY --chown=brain:brain build/home/startup.m /home/brain/matlab/
# Desktop menu customization (build/desktop; same layout as the other
# Lin4Neuro images):
# - xfce-applications.menu adds the "Neuroimaging" submenu
# - Neuroimaging.directory gives that submenu its name and brain icon
# - applications/ holds the .desktop entries; only the tools installed in this
#   image are visible (NoDisplay=false), the rest are kept but hidden
# - icons go to /usr/share/pixmaps, where both the .desktop entries and the
#   panel button (button-icon=brain64x48 in xfce4-panel.xml) look them up
# Menu entries are launched by xfdesktop without a login shell, so every Exec
# must use an absolute path: ~/.bash_aliases (which sets PATH for FSL,
# FreeSurfer, MRtrix3, ...) is not read here.
COPY --chown=brain:brain build/desktop/menus/xfce-applications.menu /home/brain/.config/menus/xfce-applications.menu
COPY --chown=brain:brain build/desktop/desktop-directories/ /home/brain/.local/share/desktop-directories/
COPY --chown=brain:brain build/desktop/applications/ /home/brain/.local/share/applications/
COPY build/desktop/icons/ /usr/share/pixmaps/
RUN rm -f /usr/share/backgrounds/xfce/xfce*.*p*g && \
    chmod 644 /root/.bash_aliases && \
    chmod 644 /etc/skel/.bash_aliases

# The user itself was created in Part 0; only its shell files and the VNC
# password remain to be set up here. No recursive chown over /home/brain:
# everything copied in above is already owned by brain.
RUN set -ex && \
    sed -i "s/UI.initSetting('resize', 'off');/UI.initSetting('resize', 'local');/g" /usr/share/novnc/app/ui.js && \
    echo '# Load .bashrc for bash login shells' > /home/brain/.profile && \
    echo 'if [ -n "$BASH_VERSION" ]; then' >> /home/brain/.profile && \
    echo '  . ~/.bashrc' >> /home/brain/.profile && \
    echo 'fi' >> /home/brain/.profile && \
    chmod 644 /home/brain/.bash_aliases /home/brain/.profile && \
    mkdir -p /home/brain/.vnc && \
    echo "lin4neuro" | vncpasswd -f > /home/brain/.vnc/passwd && \
    chmod 600 /home/brain/.vnc/passwd && \
    chown -R brain:brain /home/brain/.profile /home/brain/.vnc

# (The old Part 4 "System cleanup" and Part 5 "MATLAB MCR cleanup" are gone:
#  deleting files here cannot shrink the image, so that work now happens in
#  the builder stage before the COPY steps.)

# Part 4: Final configuration
RUN set -ex && \
    # Git settings for repositories that live on a bind-mounted share folder.
    # Docker Desktop can present a Windows or macOS folder to the container as
    # root-owned and with synthetic 0777 modes. Git then refuses to work in it
    # ("fatal: detected dubious ownership in repository") and reports every
    # file as mode-changed (100644 -> 100755). Both settings go into
    # /etc/gitconfig so that they apply to brain and root alike, without the
    # participant having to configure anything.
    git config --system --add safe.directory '*' && \
    git config --system core.fileMode false && \
    mkdir -p /home/brain/logs && \
    chmod 1777 /tmp && \
    mkdir -p /home/brain/.config/xfce4/terminal \
             /home/brain/.config/xfce4/xfconf/xfce-perchannel-xml && \
    chown -R brain:brain /home/brain/.config && \
    chown -R brain:brain /home/brain/logs && \
    mkdir -p /home/brain/.dbus && \
    chown -R brain:brain /home/brain/.dbus

# Copy configuration files
COPY --chown=brain:brain build/desktop/xfce4-desktop.xml /home/brain/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml
COPY --chown=brain:brain build/desktop/xfce4-panel.xml /home/brain/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml
COPY --chown=brain:brain build/desktop/terminalrc /home/brain/.config/xfce4/terminal/terminalrc
COPY build/init/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
# macOS の共有フォルダで生成される ._* / .DS_Store を定期的に消す常駐スクリプト。
# これらがあるとコンテナの GUI でファイルマネージャが開けなくなる。自動起動は
# せず、困った受講者が端末から auto_clean_metadata.sh と打って使う（PATH が
# 通っているので引数もパスも要らない）。Windows/Linux では消すものがないので、
# 全環境に入れておいて害はない。
COPY --chmod=755 build/bin/auto_clean_metadata.sh /usr/local/bin/auto_clean_metadata.sh
COPY build/init/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY build/init/startup.sh /usr/local/bin/startup.sh

# Set final permissions
RUN chmod +x /usr/local/bin/entrypoint.sh && \
    chmod +x /usr/local/bin/startup.sh

# Expose port for noVNC
EXPOSE 6080

# Report "healthy" once the XFCE window manager is running and noVNC serves
# its page. Launcher scripts poll "docker inspect --format {{.State.Health.Status}}"
# instead of guessing a fixed wait time. start-period covers the slow first
# start under emulation on Apple Silicon.
HEALTHCHECK --interval=10s --timeout=5s --start-period=120s --retries=3 \
  CMD pgrep -x xfwm4 >/dev/null && wget -qO- http://127.0.0.1:6080/vnc.html >/dev/null || exit 1

# startup.sh runs as ROOT first, then switches to brain user
ENV USER=brain

# Set the default command to run on container start
CMD ["/usr/local/bin/startup.sh"]
